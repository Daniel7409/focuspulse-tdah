# ── IA (SIEMPRE en env var, nunca hardcodeado) ─────────────────────────────
AI_MODEL=claude-sonnet-4-6
ANTHROPIC_API_KEY=                    # SOLO servidor — jamás NEXT_PUBLIC_
AI_DAILY_BUDGET_USD=20                # kill-switch de gasto global

# ── Supabase (proyecto "FocusPulse TDAH", nomenclatura nueva) ──────────────
NEXT_PUBLIC_SUPABASE_URL=https://dbmxnlkucrgvyxxtzswj.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxx   # pública por diseño (RLS la protege)
SUPABASE_URL=https://dbmxnlkucrgvyxxtzswj.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxxx                         # SOLO servidor

# ── Email de retención (Resend, dominio mkt.focuspulsetdah.com) ───────────
RESEND_API_KEY=
EMAIL_FROM_MKT=FocusPulse TDAH <hola@mkt.focuspulsetdah.com>

# ── URL pública del sitio (dominio propio) ─────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://focuspulsetdah.com

# ── Venta (Hotmart) — se completa en el paso de Hotmart ────────────────────
HOTMART_HOTTOK=

# ── Cron de bienvenida/activación D1-D3-D7 (Vercel Cron Jobs) ──────────────
# Vercel manda este valor como "Authorization: Bearer <valor>" en cada invocación real del
# cron — nunca se pide ni se pega a mano, se genera y se guarda directo en Vercel.
CRON_SECRET=
